platform :osx, '11.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'ephemeral', 'Flutter-Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure \"flutter pub get\" is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Flutter-Generated.xcconfig, then run \"flutter pub get\""
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_macos_podfile_setup

$FirebaseSDKVersion = '10.29.0'

target 'Runner' do
  use_frameworks!
  pod 'FirebaseCore', '10.29.0'
  pod 'FirebaseCoreInternal', '10.29.0'
  pod 'FirebaseMessaging', '10.29.0'

  flutter_install_all_macos_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_macos_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['CODE_SIGN_IDENTITY'] = '-'
      config.build_settings['DEVELOPMENT_TEAM'] = ''
      config.build_settings['MACOSX_DEPLOYMENT_TARGET'] = '11.0'
    end
  end

  # Fix CocoaPods frameworks code signing bug by appending a force-sign loop at the end of Pods-Runner-frameworks.sh
  frameworks_file = File.join(installer.sandbox.root, 'Target Support Files', 'Pods-Runner', 'Pods-Runner-frameworks.sh')
  if File.exist?(frameworks_file)
    text = File.read(frameworks_file)
    # Check if we already appended it to prevent duplicate appends
    unless text.include?('Force sign all frameworks inside the target build directory')
      force_sign_script = %Q{
# Force sign all frameworks inside the target build directory
echo "Cleaning Apple Double metadata files..."
find "${TARGET_BUILD_DIR}/${FRAMEWORKS_FOLDER_PATH}" -name "._*" -delete
echo "Force signing all frameworks in target build directory..."
find "${TARGET_BUILD_DIR}/${FRAMEWORKS_FOLDER_PATH}" -type d -name "*.framework" | while read -r fw; do
  echo "Force signing framework: $fw"
  /usr/bin/codesign --force --sign "-" --preserve-metadata=identifier,entitlements "$fw"
done
}
      text += force_sign_script
      File.write(frameworks_file, text)
    end
  end
end
